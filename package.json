{
  "name": "pult",
  "version": "0.3.12",
  "private": true,
  "license": "MIT",
  "description": "Background daemon, CLI and desktop window that runs your own claude and codex CLIs as long-lived agents, with one Inbox for every permission question",
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "agent-orchestration",
    "cli",
    "daemon",
    "inbox",
    "electron"
  ],
  "homepage": "https://github.com/pawellazarew/pult#readme",
  "bugs": {
    "url": "https://github.com/pawellazarew/pult/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pawellazarew/pult.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pult": "dist/cli/main.js",
    "pultd": "dist/daemon/main.js"
  },
  "files": [
    "dist",
    "service",
    "runtime.env",
    "mcp"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && node scripts/build-ui.mjs --tests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json",
    "ui:build": "node scripts/build-ui.mjs",
    "ui:watch": "node scripts/build-ui.mjs --watch",
    "ui:test": "node scripts/build-ui.mjs --tests && node --test dist-ui-test/*.test.js",
    "pretest": "npm run build",
    "test": "node --test dist-test/*.test.js dist-ui-test/*.test.js",
    "clean": "rm -rf dist dist-test dist-ui-test",
    "smoke:claude": "npm run build && node scripts/smoke-claude.mjs",
    "smoke:codex": "npm run build && node scripts/smoke-codex.mjs",
    "smoke:browser": "npm run build && node scripts/smoke-browser.mjs",
    "measure:f1": "npm run build && node scripts/measure-f1.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@types/node": "^22.7.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.6.3"
  }
}
